# Copy into the installed backend configuration and fill in the private password.
# Use forward slashes for Windows paths; this must match DSPACE_STATE_DIR/dspace.
dspace.dir = C:/Work/dspace-state/dspace
dspace.server.url = http://localhost:3000/server
dspace.ui.url = http://localhost:3000
rest.cors.allowed-origins = http://localhost:3000

db.url = jdbc:postgresql://127.0.0.1:5432/dspace
db.username = dspace
db.password = <set locally>
solr.server = http://127.0.0.1:8983/solr
