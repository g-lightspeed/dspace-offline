<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <packaging>jar</packaging>
    <groupId>org.webjars.npm</groupId>
    <artifactId>json-editor__json-editor</artifactId>
    <version>2.15.2</version>
    <name>@json-editor/json-editor</name>
    <description>WebJar for @json-editor/json-editor</description>
    <url>https://www.webjars.org</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <scm>
        <url>https://github.com/json-editor/json-editor</url>
        <connection>https://github.com/json-editor/json-editor.git</connection>
        <developerConnection>https://github.com/json-editor/json-editor.git</developerConnection>
        <tag>v2.15.2</tag>
    </scm>

    <developers>
        <developer>
            <id>webjars</id>
            <url>https://www.webjars.org</url>
        </developer>
    </developers>

    <licenses>
        
            <license>
                
                    <name>MIT</name>
                
                
                <distribution>repo</distribution>
            </license>
        
    </licenses>

    
    <issueManagement>
        <url>https://github.com/json-editor/json-editor/issues</url>
    </issueManagement>
    

    <dependencies>
        
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>core-js</artifactId>
            <version>[3.27.2,4.0.0-0)</version>
        </dependency>
        
        
    </dependencies>

</project>
